# Shared settings
NODE_ENV=development
ENV_FILE=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/autopoly
DATABASE_READONLY_URL=postgres://postgres:postgres@localhost:5432/autopoly
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:3000
AUTOPOLY_EXECUTION_MODE=live
# Leave empty to use the default paper file at runtime-artifacts/local/paper-state.json when AUTOPOLY_EXECUTION_MODE=paper
AUTOPOLY_LOCAL_STATE_FILE=

# Dedicated live-test env files should pin these values:
# ENV_FILE=.env.live-test
# INITIAL_BANKROLL_USD=20
# MAX_TRADE_PCT=0.1
# MAX_EVENT_EXPOSURE_PCT=0.3
# MIN_TRADE_USD=0.01
# PULSE_LIVE_MAX_BUY_TOKENS=1
# PULSE_LIVE_MIN_TRADE_USD=0.01

# Web site
ADMIN_PASSWORD=change-me
ORCHESTRATOR_INTERNAL_URL=http://localhost:4001
ORCHESTRATOR_INTERNAL_TOKEN=replace-me
# Prediction Engine hosted access. Set PREDICTION_AUTH_REQUIRED=true in production once OIDC and DB are ready.
AUTH_SECRET=
AUTH_TRUST_HOST=true
OIDC_PROVIDER_NAME=OpenID
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPE=openid email profile
PREDICTION_AUTH_REQUIRED=false
PREDICTION_INVITE_REQUIRED=true
PREDICTION_ADMIN_EMAILS=
PREDICTION_AUTO_ACTIVATE_EMAIL_DOMAINS=
PREDICTION_DAILY_RUN_LIMIT=5
PREDICTION_MONTHLY_RUN_LIMIT=50
PREDICTION_CONCURRENT_RUN_LIMIT=1
PREDICTION_ADMIN_BYPASS_QUOTA=true
# Prediction Engine frontend proxy. In production, Vercel should call the VPS-hosted service.
# Local dev/test can point at a locally hosted prediction service, for example http://127.0.0.1:8787.
# Mode: auto prefers local service on non-Vercel hosts, then VPS, then demo fallback. Use local/vps/demo to force one.
PREDICTION_ENGINE_BACKEND_MODE=auto
PREDICTION_ENGINE_LOCAL_API_URL=
PREDICTION_ENGINE_LOCAL_API_BASE_URL=
PREDICTION_ENGINE_LOCAL_API_TOKEN=
# Prefer the full endpoint; if only the base URL is set, /prediction-engine/run is appended.
PREDICTION_ENGINE_API_URL=
PREDICTION_ENGINE_API_BASE_URL=
PREDICTION_ENGINE_API_TOKEN=
PREDICTION_ENGINE_API_TIMEOUT_MS=120000

# ---------------------------------------------------------------------------
# Deep Research console (apps/web /research) — streaming driver selection.
# RESEARCH_DRIVER picks which chain runs. `mock` (default) needs zero config and
# replays the deterministic demo as a stream. `api` / `vps` are hot-swapped in
# by setting this var; if the chosen chain is not fully configured the route
# falls back to mock with a visible notice (no redeploy needed).
RESEARCH_DRIVER=mock
# mock pacing: 1 = full demo durations (~3.4s), smaller = faster.
RESEARCH_MOCK_SPEED=
# Norse-Norns capability tier the server dispatches at when the request omits one
# (the UI tier selector overrides this per run): urd = 轻快 / verdandi = 均衡(默认)
# / skuld = 旗舰. Mapped to a concrete model + token budget by @autopoly/norns.
RESEARCH_DEFAULT_TIER=verdandi

# Chain B — direct API driver (Anthropic Messages / OpenAI Chat Completions via fetch).
# Provider auto-detects from whichever key is present unless set explicitly.
RESEARCH_API_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Model override. Accepts a raw model id OR a Norns tier name (urd/verdandi/skuld).
# Empty = use the active tier's model for the detected provider family.
RESEARCH_API_MODEL=
# Empty = use the tier's token budget (urd 1024 / verdandi 2048 / skuld 4096).
RESEARCH_API_MAX_TOKENS=
# Gate live calls (cost/latency safety). Without this, the api driver replays
# the demo structure and only labels itself as Chain B.
RESEARCH_API_LIVE=false

# Chain A — VPS agent driver. POSTs to a VPS endpoint that runs the orchestrator
# provider-runtime (codex / claude-code / openclaw). Endpoint should return our
# SSE protocol or a PredictionEngineRun JSON. Falls back to PREDICTION_ENGINE_API_*.
RESEARCH_VPS_URL=
RESEARCH_VPS_BASE_URL=
RESEARCH_VPS_TOKEN=
RESEARCH_VPS_TIMEOUT_MS=120000

# Executor
WALLET_PROVIDER=private-key
PRIVATE_KEY=0x...
FUNDER_ADDRESS=0x...
SIGNATURE_TYPE=1
ONCHAINOS_BIN=onchainos
ONCHAINOS_TIMEOUT_MS=30000
# OKX Agentic Wallet path:
# WALLET_PROVIDER=onchainos
# PRIVATE_KEY=
# FUNDER_ADDRESS=0x...   # Polymarket deposit/proxy wallet
# SIGNATURE_TYPE=3       # deposit wallet / POLY_1271
# WALLET_PROVIDER=okx-agentic is kept as a legacy alias for onchainos.
# After 2026-04-28 11:00 UTC, clob.polymarket.com serves V2.
# Use https://clob-v2.polymarket.com to exercise V2 before the cutover.
POLYMARKET_HOST=https://clob.polymarket.com
CHAIN_ID=137
DEFAULT_ORDER_TYPE=FOK
# V2 collateral token — Polymarket USD (pUSD), replaces USDC.e after 2026-04-28.
# Onchain reads use this to show spectator balance; the CLOB SDK handles collateral routing automatically.
POLYGON_PUSD_CONTRACT=0xC011a7E12a19f7B1f670d46F03B03f3342E82DFB
# Optional isolation bridge for Polymarket I/O. Default runtime path uses the in-process SDK.
POLY_CLI_ENABLED=false
# Optional custom command, for example: "pnpm exec tsx"
POLY_CLI_COMMAND=
# If true, read operations also fail hard when poly-cli fails.
POLY_CLI_STRICT=false

# Orchestrator schedules and hard risk limits
AGENT_POLL_CRON=0 */3 * * *
SYNC_INTERVAL_SECONDS=30
BACKTEST_CRON=10 0 * * *
RESOLUTION_BASE_INTERVAL_MINUTES=60
RESOLUTION_URGENT_INTERVAL_MINUTES=15
DRAWDOWN_STOP_PCT=0.2
POSITION_STOP_LOSS_PCT=0.3
MAX_TOTAL_EXPOSURE_PCT=0.5
MAX_EVENT_EXPOSURE_PCT=0.3
MAX_POSITIONS=10
MAX_TRADE_PCT=0.1
MIN_TRADE_USD=10
INITIAL_BANKROLL_USD=10000

# Orchestrator runtime
AGENT_RUNTIME_PROVIDER=codex
ARTIFACT_STORAGE_ROOT=runtime-artifacts
PROVIDER_TIMEOUT_SECONDS=0
PULSE_TIMEOUT_MODE=default
# Blank = only .env.pizza appends to apps/web/public/equity-history.json.
# Set false for Pizza dry runs that should not update the public chart, or true for an intentional public-history run.
PUBLIC_EQUITY_HISTORY_ENABLED=

# Pulse storage and market discovery
PULSE_SOURCE_REPO=all-polymarket-skill
PULSE_SOURCE_REPO_DIR=vendor/repos/all-polymarket-skill
PULSE_FETCH_TIMEOUT_SECONDS=300
PULSE_PAGES=5
PULSE_EVENTS_PER_PAGE=50
PULSE_MIN_FETCHED_MARKETS=5000
PULSE_MIN_LIQUIDITY_USD=5000
PULSE_MAX_CANDIDATES=12
PULSE_REPORT_CANDIDATES=4
PULSE_REPORT_COMMENT_LIMIT=20
PULSE_REPORT_TIMEOUT_SECONDS=0
PULSE_DIRECT_RENDER_TIMEOUT_SECONDS=1200
PULSE_MIN_TRADEABLE_CANDIDATES=5
# Temporary entry throttles. Leave unset/default for normal sizing.
PULSE_ENTRY_MAX_PLANS=4
PULSE_ENTRY_FIXED_NOTIONAL_USD=
PULSE_MAX_AGE_MINUTES=30
PULSE_MAX_MARKDOWN_CHARS=24000
PULSE_WEB_SEARCH_ENABLED=true
PULSE_WEB_SEARCH_TIMEOUT_SECONDS=120

# Codex provider
# *_MODEL accepts a raw model id OR a Norse-Norns tier name (urd / verdandi /
# skuld), resolved per provider family via @autopoly/norns. Empty = pass through
# (provider default). Existing raw model ids are unaffected.
CODEX_COMMAND=
CODEX_MODEL=
CODEX_SKILL_ROOT_DIR=vendor/repos/all-polymarket-skill
CODEX_SKILL_LOCALE=zh
CODEX_SKILLS=polymarket-market-pulse,portfolio-review-polymarket,poly-position-monitor,poly-resolution-tracking,api-trade-polymarket

# OpenClaw provider
# Empty command uses scripts/openclaw-agent-command.mjs, which wraps OpenClaw 2026.5.x `openclaw agent`.
OPENCLAW_COMMAND=
OPENCLAW_MODEL=
OPENCLAW_SKILL_ROOT_DIR=vendor/repos/all-polymarket-skill
OPENCLAW_SKILL_LOCALE=zh
OPENCLAW_SKILLS=polymarket-market-pulse,portfolio-review-polymarket,poly-position-monitor,poly-resolution-tracking,api-trade-polymarket

# Rough Loop
ROUGH_LOOP_PROVIDER=codex
ROUGH_LOOP_FILE=rough-loop.md
ROUGH_LOOP_POLL_SECONDS=60
ROUGH_LOOP_MAX_RETRIES=3
ROUGH_LOOP_TASK_TIMEOUT_MINUTES=45
ROUGH_LOOP_REQUIRE_CLEAN_TREE=1
ROUGH_LOOP_RELAX_GUARDRAILS=0
ROUGH_LOOP_AUTO_COMMIT=1
ROUGH_LOOP_AUTO_PUSH=0
ROUGH_LOOP_PAUSE_FILE=.rough-loop.pause

# Raven Delta (apps/raven-delta — news-impact engine, port 3300)
# Engine: auto = deepseek if DEEPSEEK_API_KEY set, else claude CLI if DELTA_CLAUDE_CLI=1, else rules fallback.
DELTA_PROVIDER=
DELTA_CLAUDE_CLI=
DELTA_CLAUDE_MODEL=
DELTA_ALLOWED_TOOLS=
DELTA_DEEPSEEK_MODEL=
DELTA_AGENT_TIMEOUT_MS=
# Access token: when set, /api/ingest requires it and anonymous /api/analyze callers
# can only email allowlisted recipients. Leave empty for local demo.
DELTA_ACCESS_TOKEN=
# Comma-separated emails anonymous callers may deliver to (secret-free safety valve).
DELTA_EMAIL_ALLOWLIST=
# Email sending (secret! setting RESEND_API_KEY makes email delivery real).
RESEND_API_KEY=
DELTA_EMAIL_FROM=
DELTA_EMAIL_WEBHOOK_URL=
# Ingest push defaults (used by POST /api/ingest).
DELTA_INGEST_EMAILS=
DELTA_INGEST_WS_TOPIC=
# Ingest quality gate: 0-100 materiality bar before a full analysis+push (default 60).
DELTA_GATE_MIN_SCORE=
# Recipient for `pnpm delta:test-email` (defaults to the operator test inbox).
DELTA_TEST_EMAIL=
# WebSocket hub (scripts/delta-ws/server.ts, `pnpm delta:ws`).
DELTA_WS_PORT=
DELTA_WS_HOST=
# Write side: /broadcast requires this bearer token when set.
DELTA_WS_TOKEN=
# Read side: WS subscriptions require ?token= only when this is set.
DELTA_WS_SUBSCRIBE_TOKEN=
DELTA_WS_BROADCAST_URL=
DELTA_DELIVERY_TIMEOUT_MS=

# ---------------------------------------------------------------------------
# Delta PM — news-driven US-equity paper agent (services/delta-pm, PRD
# docs/us-stock-trading-prd.md). Phase 0 SHADOW mode: no keys, no signer.
# The TWO USER-DECIDED risk anchors (2026-08-22) — changing either requires
# explicit user sign-off:
#   DELTAPM_HARD_STOP_ADVERSE_PCT   per-position hard stop (default 0.2 = −20%)
#   DELTAPM_PORTFOLIO_HALT_LOSS_PCT portfolio halt vs initial capital (0.25)
DELTAPM_STATUS_PORT=
# Token gating POST /ingest (manual news + console paste-full-text). Empty = disabled.
DELTAPM_INGEST_TOKEN=
DELTAPM_FEED_POLL_SECONDS=
# Analysis engine: auto | deepseek | claude | rules (auto prefers DEEPSEEK_API_KEY, then claude CLI).
DELTAPM_PROVIDER=
DELTAPM_ANALYSIS_CONCURRENCY=
DELTAPM_INITIAL_CAPITAL_USD=
DELTAPM_HARD_STOP_ADVERSE_PCT=
DELTAPM_PORTFOLIO_HALT_LOSS_PCT=
DELTAPM_RISK_BUDGET_PCT=
DELTAPM_TIER1_CAP_PCT=
DELTAPM_TIER2_CAP_PCT=
DELTAPM_TIER3_CAP_PCT=
DELTAPM_GROSS_CAP_PCT=
DELTAPM_NET_CAP_PCT=
DELTAPM_CLUSTER_CAP_PCT=
DELTAPM_ISOLATED_MARGIN_CAP_PCT=
DELTAPM_MAX_LEVERAGE=
DELTAPM_DAILY_LOSS_STOP_PCT=
DELTAPM_COOLDOWN_HOURS=
DELTAPM_MIN_TRADE_USD=
# Console (apps/delta-pm-console, :3400)
DELTAPM_STATUS_URL=
DELTAPM_CONSOLE_MOCK=
