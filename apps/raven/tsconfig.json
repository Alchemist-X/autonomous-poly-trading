{
  "extends": "../../config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "es2022"],
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/forecast-engine/src/types.ts",
    "../../packages/forecast-engine/src/store.ts"
  ],
  "exclude": ["node_modules"]
}
