# --- access control (required for any public host) ---
# Shared invite token; every visitor unlocks once via https://host/?token=<value>
RAVEN_ACCESS_TOKEN=

# --- model provider ---
# claude = web research via the claude CLI (recommended for the hosted service)
FORECAST_PROVIDER=claude
# Subscription path (recommended): run `claude setup-token` on your own machine
# and paste the token here. Alternative: set ANTHROPIC_API_KEY instead.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=

# Optional cheap/no-web test provider (used when FORECAST_PROVIDER=deepseek)
# DEEPSEEK_API_KEY=

# --- engine tuning (defaults shown) ---
FORECAST_MAX_ROUNDS=3
FORECAST_MIN_ROUNDS=2
# FORECAST_MODEL=            # claude CLI model override, e.g. a smaller model
# FORECAST_AGENT_TIMEOUT_MS=360000

# --- forecast API + MCP service (the second compose service, port 8787) ---
# API callers authenticate with `Authorization: Bearer <token>` (or x-api-key /
# ?token=). Falls back to RAVEN_ACCESS_TOKEN when unset or empty; set a
# dedicated value so API access can be rotated independently of the web app.
# FORECAST_API_TOKEN=
# Public base URL used in links inside API/MCP answers and the PDF, e.g.
# http://<server-ip>:8787 — leave unset to derive from the request Host header.
# FORECAST_API_PUBLIC_URL=
# FORECAST_API_MAX_CONCURRENT=2   # parallel engine runs before 429

# --- daily quota + invite codes (applies to BOTH surfaces, counted
# separately: the web app and the API each get this many engine runs per UTC
# day; beyond that a request must carry a valid invite code — web: input on
# the ask screen, API: "x-invite-code" header or "invite" body field, MCP:
# invite_code arg). Codes live in a file-backed store on the artifacts volume
# (runtime-artifacts/invites/events.jsonl) with per-code label / max-uses /
# expiry / revocation / usage metering; manage them with the invite CLI:
#   docker exec raven-forecast-api-1 pnpm --filter @autopoly/forecast-api invite list
# FORECAST_INVITE_CODE is only the FIRST-BOOT SEED (created as an unlimited
# code); afterwards the store is the source of truth.
FORECAST_DAILY_QUOTA=20
FORECAST_INVITE_CODE=raven-labs

# --- paper trading agent (simulation only — never places real orders) ---
# Evaluation cycles run at these UTC times; each open position is re-assessed
# by an ISOLATED DeepSeek/Kimi engine run (no position/price data in the
# prompt), then the harness compares belief vs executable price and exits on
# negative net edge (hybrid 50% market + 50% resting limit; stop-loss = 100%
# market). Kimi instead of DeepSeek: set DEEPSEEK_BASE_URL=https://api.moonshot.cn/v1,
# FORECAST_DEEPSEEK_MODEL=<kimi model>, DEEPSEEK_API_KEY=<moonshot key>.
# Web research for evaluations is ON by default (function-calling loop with a
# keyless DuckDuckGo backend; set TAVILY_API_KEY to upgrade reliability, or
# FORECAST_WEB_SEARCH=0 to turn it off). Citations are then verified against
# the real search trace, like the claude provider.
# TAVILY_API_KEY=
# PAPER_BANKROLL_USD=1000
# PAPER_EVAL_TIMES_UTC=00:10,08:10,16:10
# PAPER_EXIT_EDGE_PP=0          # exit when hold-vs-exit net edge (pp) drops below this
# PAPER_STOP_LOSS_PCT=0.35
# PAPER_HYBRID_MARKET_RATIO=0.5
# PAPER_LIMIT_TTL_HOURS=8
# PAPER_WATCHLIST=/app/runtime-artifacts/paper-agent/watchlist.txt   # optional auto-entries
# PAPER_ENTRY_EDGE_PP=8
# PAPER_ENTRY_NOTIONAL_USD=50
# PAPER_MAX_POSITIONS=10
# PAPER_MAX_PER_EVENT=1          # cap positions sharing one Gamma event (same macro bet, diff expiries)
# PAPER_MAX_EVALS_PER_CYCLE=12
# PAPER_SCAN_MIN_LIQUIDITY_USD=5000   # repo risk hard floor — don't lower
# PAPER_SCAN_MIN_VOLUME24H_USD=2000   # activity gate (loosened from 10k, 2026-07-03)
# PAPER_SCAN_PER_CATEGORY=12          # candidates per category before the eval budget queues them
